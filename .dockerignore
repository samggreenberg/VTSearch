# Version control
.git/
.gitignore

# Python caches
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/

# Testing / coverage
.pytest_cache/
.coverage
coverage.json
htmlcov/

# Runtime data (mount as a volume instead)
data/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# Tests (not needed at runtime)
tests/
run-tests.sh

# Frontend source (build output is in static/)
frontend/

# Docker files (no need to copy into the image)
Dockerfile
Dockerfile.gpu
Dockerfile.siglip
docker-compose*.yml

# Docs (not needed at runtime)
docs/
README.md

# Claude config
.claude/
CLAUDE.md

# Scripts (not needed at runtime)
download_models.sh

# Local virtual environment
venv/
