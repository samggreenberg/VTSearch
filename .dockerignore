# Version control
.git/
.gitignore

# Python caches
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/

# Testing / coverage
.pytest_cache/
.coverage
coverage.json
htmlcov/

# Runtime data (mount as a volume instead)
data/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# Tests (not needed at runtime)
tests/
run-tests.sh

# Frontend node_modules and build cache; the Dockerfile's frontend
# build stage runs `npm ci` and `ng build` inside the image, so we want
# the frontend source in the context but never these generated dirs.
frontend/node_modules/
frontend/.angular/
frontend/dist/

# Docker files (no need to copy into the image)
docker/

# Docs (not needed at runtime)
docs/
README.md

# Claude config
.claude/
CLAUDE.md

# Scripts (not needed at runtime)
scripts/download_models.sh
scripts/install-cpu.sh
scripts/install-gpu.sh
scripts/install-plugin-deps.sh

# Local virtual environment
venv/
