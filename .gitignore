__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
venv/
.coverage
coverage.json
htmlcov/
.env
.DS_Store

# Demo dataset files
data/

# Angular build output (generated by `cd frontend && npm run build:prod`)
# All generated files change on every build and cause merge conflicts.
# Only hand-crafted assets (favicons, logos) are tracked.
static/index.html
static/main.js
static/polyfills.js
static/styles.css
static/chunk-*.js
static/3rdpartylicenses.txt
static/prerendered-routes.json

# Angular / Node
frontend/node_modules/
frontend/dist/
frontend/.angular/

# Generated OpenAPI TypeScript client. Regenerated by
# `npm run generate-api-client` from `frontend/openapi.json`
# (which IS tracked). The `prebuild` / `prebuild:prod` hooks in
# `frontend/package.json` also regenerate it before every Angular build.
frontend/src/app/generated/

/venv/
*symbolic_link

# Build-baked version stamp (Docker build arg writes this; never commit it).
vtsearch/_version.txt

# Cached gated-model weights populated by scripts/cache_gated_models.sh.
# Used by Dockerfile.image-embedders so the build doesn't need an HF token.
# Never commit the weights themselves — they're large and licence-restricted.
# (model_cache/.gitkeep is tracked so the dir exists for the Dockerfile COPY.)
model_cache/*
!model_cache/.gitkeep

# Per-user Claude Code settings overlay — holds secrets like HF_TOKEN.
# Must never be committed.
.claude/settings.local.json
