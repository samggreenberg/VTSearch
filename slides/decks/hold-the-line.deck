# (thresh)Hold The Line — advances in VTSearch calibration.
# Mildly technical audience with no prior exposure to VTSearch: the opening
# third builds the tool, and lands on the one object the whole talk is about —
# a line through a ranking that decides twice, what comes back and what you are
# asked next. Then the ideas, in order: four iterations on where the line goes,
# then the same machinery walked a second time along the Inclusion axis — where
# the *user* wants it — and then the epilogue that closed the cut-rule question
# for good.
#
# The deck is ideas, not experiments. Every measurement slide is parked after
# the Questions slide as backup: this talk presents findings, and a room that
# wants the study behind one of them can be shown it. See #3246.
#
# The outline fragment appears five times, once before each section, marked
# with `+at1` … `+at5` — one fragment used five ways rather than five copies to
# keep in step.

theme: vtsearch
paginate: true

slides:
  title-hold-the-line

  # 1 — VTSearch
  outline-hold-the-line +at1
  problem
  ui-tour
  vote-boundary

  # 2 — Where the line goes
  outline-hold-the-line +at2
  xcal
  gmm-idea
  blend
  blend-schedule
  anchored-gmm
  quantile-transfer

  # 3 — Where you want it instead
  outline-hold-the-line +at3
  inclusion-cost
  inclusion-knob
  inclusion-walk
  inclusion-tilt
  inclusion-acq

  # 4 — A smarter cut
  outline-hold-the-line +at4
  evt-midpoint
  evt-gumbel
  evt-close

  # 5 — What is still open
  outline-hold-the-line +at5
  calib-roadmap

  thanks

  # ── Backup, after the Questions slide ───────────────────────────────────
  # Region voting, and every measurement the talk asserts without showing.
  # Parked rather than deleted: asked "how do you know?", turn to one of these.
  voting-modes
  how-we-measure
  positives
  xcal-results
  gmm-fragility
  blend-results
  anchored-results
