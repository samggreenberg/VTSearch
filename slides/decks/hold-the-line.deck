# (thresh)Hold The Line — advances in VTSearch calibration.
# Mildly technical audience with no prior exposure to VTSearch: the first
# third builds the loop the threshold lives inside, so that the second job of
# the threshold — choosing the next question — lands before the iterations do.
# Then four iterations, each as [the idea, then the measurement] — the fourth
# carrying an extra slide between the two, because its idea is not finished
# until scores stop being averaged as numbers. Then the same machinery walked a
# second time along the Inclusion axis — the knob that did nothing, the quantile
# rule that repaired it, the tilt that gave it back once the fused fit had taken
# it away again, and the second cut that closes the loop onto the promise made
# on slide seven — and the cut-rule line told as the epilogue that proves the
# anchored fit won.

theme: vtsearch
paginate: true

slides:
  title-hold-the-line
  outline-hold-the-line
  problem
  ui-tour
  voting-modes
  vts-loop
  threshold-two-jobs
  how-we-measure
  positives
  xcal
  xcal-results
  gmm-idea
  gmm-fragility
  blend
  blend-results
  blend-schedule
  anchored-gmm
  quantile-transfer
  anchored-results
  anchored-kappa
  inclusion-knob
  inclusion-walk
  inclusion-tilt
  inclusion-acq
  evt-line
  evt-close
  calib-roadmap
  thanks
