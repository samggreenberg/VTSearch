{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "node scripts/openapi-gen-cached.mjs && node scripts/build-stamp.mjs",
    "build": "ng build",
    "prebuild:prod": "node scripts/openapi-gen-cached.mjs && node scripts/build-stamp.mjs",
    "build:prod": "NG_CLI_ANALYTICS=false ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "generate-api-client": "node scripts/openapi-gen-cached.mjs --force && node scripts/build-stamp.mjs",
    "regenerate-openapi-snapshot": "cd .. && python scripts/dump_openapi.py > frontend/openapi.json",
    "pretest": "node scripts/openapi-gen-cached.mjs && node scripts/build-stamp.mjs",
    "test": "ng test --watch",
    "pretest:ci": "node scripts/openapi-gen-cached.mjs && node scripts/build-stamp.mjs",
    "test:ci": "ng test --no-watch"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.17",
    "@angular/compiler": "^21.2.17",
    "@angular/core": "^21.2.17",
    "@angular/forms": "^21.2.17",
    "@angular/platform-browser": "^21.2.17",
    "@angular/router": "^21.2.17",
    "marked": "^14.1.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.16",
    "@angular/cli": "^21.2.16",
    "@angular/compiler-cli": "^21.2.17",
    "jsdom": "^25.0.1",
    "ng-openapi-gen": "^1.0.5",
    "typescript": "~5.9.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "pacote": {
      "tar": "^7.5.13"
    },
    "vite": "^6.4.2",
    "esbuild": "^0.28.1",
    "postcss": "^8.5.10",
    "qs": "^6.16.0",
    "fast-uri": "^3.1.7",
    "@angular/build": {
      "undici": "^7.29.0"
    }
  }
}
