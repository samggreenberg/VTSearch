{
  "model": {
    "name": "retinaface_r50",
    "feat_stride": [8, 16, 32],
    "num_anchors": 2,
    "min_sizes": [[16, 32], [64, 128], [256, 512]],
    "variances": [0.1, 0.2],
    "score_threshold": 0.5,
    "iou_threshold": 0.45,
    "nms_pre": 1000,
    "max_nms": 30000,
    "topk": 400,
    "min_image_size": 12,
    "max_image_size": 2048,
    "transforms": [
      {"name": "Normalize",
       "args": {"mean": [0.485, 0.456, 0.406],
                "std": [0.229, 0.224, 0.225]}},
      {"name": "Resize",
       "args": {"max_size": 2048}},
      {"name": "ToTensor"}
    ]
  }
}
