{
  "model": {
    "name": "arcface_r50",
    "compatibility": "oss-arcface-r50:1",
    "embedding_dim": 512,
    "transforms": [
      {"name": "Align", "args": {"height": 112, "width": 112, "fallback": "crop"}},
      {"name": "Normalize", "args": {"mean": [0.5, 0.5, 0.5], "std": [0.5, 0.5, 0.5]}},
      {"name": "ToTensor"}
    ]
  }
}
