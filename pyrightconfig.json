{
  "include": ["vtsearch", "vtscore", "imagekit", "tests", "tests_lib", "tests_shared"],
  "exclude": [
    "**/__pycache__",
    "**/node_modules",
    "frontend",
    "scripts",
    "data"
  ],
  "extraPaths": [
    "tests",
    "tests_lib",
    "scripts/experiments",
    "scripts/experiments/pile",
    "scripts/experiments/calibration"
  ],
  // `scripts` stays excluded from checking, but the modules its tests import
  // must still RESOLVE. `tests_lib/meta/test_pile_*.py` put the pile directory
  // on `sys.path` and import `pile_config` / `pilebuild` from it, exactly as
  // `build_pile.py` and its sibling scripts do; `test_experiments_common.py`
  // does the same for `_expcommon`, which every study's `common.py` (and
  // `pile_config`) reaches by the same sys.path trick.
  //
  // `calibration` joined them for `test_calibration_dataset_registry.py`, which
  // imports `experiment_config` by bare name the way every launcher and
  // `run_cells.py` do. It is the same claim as the two above -- a directory the
  // harness puts on `sys.path` at runtime -- and not a new kind of exception.

  // `typings/` holds the local `transformers` stub (#5077; see docs/TESTING.md).
  // It is pyright's default stubPath, which resolves against this file's
  // directory -- that is why the directory sits at the repo root. Named here so
  // it has a visible owner; scripts/gates/pyright-incremental.py reads the same
  // key.
  "stubPath": "typings",
  "pythonVersion": "3.11",
  "typeCheckingMode": "basic",
  "useLibraryCodeForTypes": true,
  "reportMissingImports": "error",
  "reportMissingTypeStubs": "none"
}
