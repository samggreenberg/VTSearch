{
  "include": ["vtsearch", "tests", "tests_lib"],
  "exclude": [
    "**/__pycache__",
    "**/node_modules",
    "frontend",
    "scripts",
    "data"
  ],
  "extraPaths": ["tests", "tests_lib"],
  "pythonVersion": "3.10",
  "typeCheckingMode": "basic",
  "useLibraryCodeForTypes": true,
  "reportMissingImports": "error",
  "reportMissingTypeStubs": "none"
}
