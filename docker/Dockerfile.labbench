# -----------------------------------------------------------------
# VTSearch: LabBench CPU image (one media type, its default embedder only)
#
# Streamlined for the LabBench environment: browsing/voting on a dataset of
# one media type with that type's default embedder. The image installs only
# what that type needs, and bakes the embedder's weights in at build time so
# the container is ready to serve immediately on first run (no Hugging Face
# download needed).
#
# MEDIA_TYPE picks the type, as in docker/Dockerfile.solo, and defaults to
# image. Each supported type has its own requirements/labbench-<type>.txt;
# the build fails, listing the supported ids, for any other value:
#
#   image   SigLIP          (the default)
#   audio   CLAP General
#
# That table is informational. The baked and locked embedder is whatever the
# server warms for the type at startup, because the build runs that very
# preload (scripts/preload_default_embedder.py); this file names no model.
# What it does pin is the requirements file, curated for that embedder, so a
# change of default that needs new dependencies fails the bake step loudly
# rather than shipping an image that cannot load its own embedder.
#
# Unlike Dockerfile.solo (the full CPU image, every embedder installed), the
# other embedders for the type are not installed here, which is why the
# embedder is locked too.
#
# Streamlining knobs (all baked into this image; no flags required):
#
#   * VTSEARCH_SOLO_MEDIA_TYPE (set below) is the admin-set lock: it hides
#     the mediaType pickers in the dataset-importer and new-detector flows,
#     filters converters to ones that output this type, and preloads the
#     type's default embedder at startup. Users cannot change it. Being an
#     env var rather than a seeded settings file, it also holds when the
#     image is redeployed onto an existing /app/data volume.
#   * VTSEARCH_DATASET_MAX_AGE_DAYS=14 (below) caps dataset retention at 14
#     days for every user; it overrides the persisted file for the process
#     lifetime and is not editable via the settings API.
#   * scripts/seed_labbench_settings.py seeds the data volume: the default
#     user's ``solo_embedder_per_media_type`` locks the type to the baked
#     embedder (the importer hides its embedder dropdown; users can override
#     it in Settings > Import Defaults), and ``hidden_plugins`` drops the
#     Downloaded Demo Media importer plus any plugin the slim requirements
#     leave without its dependencies (for image, the Aud2Img converter). The
#     same hides are available at runtime with ``--hide-plugin`` in
#     dev-mode invocations.
#
# Build (from repo root):
#   docker build -f docker/Dockerfile.labbench -t vtsearch:labbench .
#   docker build -f docker/Dockerfile.labbench --build-arg MEDIA_TYPE=audio -t vtsearch:labbench-audio .
# Run:
#   docker run -p 5000:5000 -v vtsearch-data:/app/data vtsearch:labbench
# Or use docker/compose/docker-compose.labbench.yml / docker-compose.labbench-audio.yml.
# -----------------------------------------------------------------

# ---------- frontend build stage ----------
# Builds the Angular SPA inside the image so callers never have to run
# `npm run build:prod` on the host. Output lands at /static because
# frontend/angular.json sets outputPath to "../static" relative to the
# frontend/ workdir. The final stage COPYs /static into /app/static.
FROM node:20-slim AS frontend
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build:prod

FROM python:3.12-slim AS base

WORKDIR /app

# ---------- core dependency layer (shared by every MEDIA_TYPE) ----------
# requirements/labbench.txt is what every LabBench image needs whatever its
# media type: the framework, the numeric and model stack, Browse. It is
# installed before MEDIA_TYPE is declared, so an image and an audio build
# share this layer and the one below.
COPY requirements/labbench.txt requirements/
RUN pip install --no-cache-dir --upgrade pip setuptools && \
    pip install --no-cache-dir \
        --prefer-binary \
        -r requirements/labbench.txt

# ---------- VTSBrowse signpost naming (toponymy) ----------
# Docker builds never run scripts/install.sh, so this step mirrors its
# `vts_install_toponymy` by hand. Without it the image ships without
# `toponymy` and every Browse map renders unlettered, behind a one-time
# "VTSBrowse signposts are disabled" error in the log (issue #3852).
#
# `--no-deps` is the whole reason this cannot live in requirements/ (pip
# rejects the flag inside a requirements file): toponymy 0.5.2 pins
# `transformers<5.0.0`, which a plain install would honour by downgrading the
# image's transformers stack. That pin is empirically unnecessary for our
# usage -- see docs/SETUP.md -- so the package goes in
# bare. Its real dependencies are declared on its behalf in
# requirements/labbench.txt (this image installs itself with `--no-deps -e .`,
# so pyproject.toml's declarations never reach it); apricot-select stays in
# this dedicated step, as in install.sh, because it ships a legacy setup.py
# sdist rather than a wheel.
RUN pip install --no-cache-dir apricot-select && \
    pip install --no-cache-dir --no-deps "toponymy==0.5.2"

# ---------- the media type's dependencies ----------
# MEDIA_TYPE is declared here, after the shared layers above. The check names
# the supported types before pip would fail on a missing requirements file.
ARG MEDIA_TYPE=image
COPY requirements/labbench-*.txt requirements/
RUN if [ ! -f "requirements/labbench-${MEDIA_TYPE}.txt" ]; then \
        echo "MEDIA_TYPE='${MEDIA_TYPE}' has no LabBench image. Supported:" \
            $(ls requirements/labbench-*.txt | sed 's|.*/labbench-||; s|\.txt$||') \
            "(docker/Dockerfile.solo builds the full image for any media type)." >&2; \
        exit 2; \
    fi && \
    pip install --no-cache-dir \
        --prefer-binary \
        -r "requirements/labbench-${MEDIA_TYPE}.txt"

# ---------- the app itself ----------
# `--no-deps`: the requirements files above are this image's whole
# dependency set, so pyproject.toml's (the full app's) must not reach it.
COPY pyproject.toml LICENSE NOTICE ./
COPY vtsearch/ vtsearch/
COPY vtscore/ vtscore/
RUN pip install --no-cache-dir --no-deps -e .

# ---------- bake the media type's default embedder ----------
# Weights go to a non-volume path so a volume mounted on /app/data cannot mask
# them; the app reads the cache location from VTSEARCH_MODELS_DIR. TORCH_HOME
# points at the same place so a torch.hub-loaded checkpoint is baked there too
# rather than under root's $HOME, which the runtime user cannot see.
#
# The step loads the embedder exactly as the server does at startup, so it is
# also the build-time proof that the slim requirements can run it.
# PYTHONUNBUFFERED + python -u keep the download progress flowing to BuildKit
# (run `docker build --progress=plain ...` to see it live), and
# HF_HUB_DOWNLOAD_TIMEOUT makes a stalled connection error out (and
# huggingface_hub auto-retry) instead of blocking the build forever.
ENV VTSEARCH_MODELS_DIR=/opt/vtsearch/models \
    TORCH_HOME=/opt/vtsearch/models \
    HF_HUB_DOWNLOAD_TIMEOUT=120 \
    PYTHONUNBUFFERED=1
COPY scripts/preload_default_embedder.py scripts/preload_default_embedder.py
RUN mkdir -p "$VTSEARCH_MODELS_DIR" && \
    python -u scripts/preload_default_embedder.py "$MEDIA_TYPE"

# ---------- application layer ----------
COPY . .

# Overlay the freshly-built Angular bundle from the frontend stage so
# the image is never served with a stale checked-in static/ snapshot.
RUN rm -rf /app/static
COPY --from=frontend /static/ /app/static/

# Bake the version into the image. See Dockerfile for the pattern.
ARG VTSEARCH_VERSION=
RUN if [ -n "$VTSEARCH_VERSION" ]; then echo "$VTSEARCH_VERSION" > vtsearch/_version.txt; fi

# Seed the data volume (data/settings.json and data/user_settings.json)
# so a LabBench container launches streamlined. Docker copies these files into
# a fresh named volume on first creation, so a new deployment comes
# ready-to-serve without any first-run setup. What is seeded, and why, is in
# the script's docstring.
RUN python scripts/seed_labbench_settings.py "$MEDIA_TYPE" /app/data

# Runtime data directory (settings, embeddings, datasets, media files).
# Mount a volume here to persist user data across container restarts.
# Note: model weights live under /opt/vtsearch/models, NOT this volume.
VOLUME /app/data

# Run as a non-root user. See the CPU Dockerfile for the rationale and
# the GID-0 / g=u perm pattern that lets arbitrary OpenShift UIDs write.
# /opt/vtsearch/models is also opened up so the baked weights stay
# readable when the runtime UID is unknown at build time.
RUN useradd --uid 1000 --gid 0 --create-home --home-dir /home/vtsearch vtsearch && \
    chgrp -R 0 /app /home/vtsearch /opt/vtsearch && \
    chmod -R g=u /app /home/vtsearch /opt/vtsearch

ENV HOME=/home/vtsearch
USER 1000

EXPOSE 5000

ENV OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    VTSEARCH_SERVER_INIT=1 \
    VTSEARCH_DATASET_MAX_AGE_DAYS=14 \
    VTSEARCH_SOLO_MEDIA_TYPE=${MEDIA_TYPE}

CMD ["gunicorn", "-c", "gunicorn.conf.py", "app:app"]
