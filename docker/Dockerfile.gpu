# -----------------------------------------------------------------
# VTSearch: GPU (CUDA) Docker image
#
# Build (from repo root):
#   docker build -f docker/Dockerfile.gpu -t vtsearch:gpu .
# Run:
#   docker run --gpus all -p 5000:5000 -v vtsearch-data:/app/data vtsearch:gpu
#
# Requires the NVIDIA Container Toolkit on the host:
#   https://docs.nvidia.com/datacenter/cloud-native/container-toolkit/
# -----------------------------------------------------------------

# ---------- frontend build stage ----------
# Builds the Angular SPA inside the image so callers never have to run
# `npm run build:prod` on the host. Output lands at /static because
# frontend/angular.json sets outputPath to "../static" relative to the
# frontend/ workdir. The final stage COPYs /static into /app/static.
FROM node:20-slim AS frontend
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build:prod

# Ubuntu 24.04 is the first CUDA base whose system Python (3.12) is not EOL;
# 22.04's is 3.10. The CUDA minor matches the cu129 torch wheel and the RAPIDS
# 26.8 stack installed below, which both carry CUDA 12.9 libraries of their
# own; the base sets the host-driver floor (`NVIDIA_REQUIRE_CUDA`: a driver new
# enough for CUDA 12.9, or one of the R535..R570 branches; see docs/DEPLOYMENT.md
# "Choosing an image"). Anything older would let the container start on a
# driver the wheels then fail on.
FROM nvidia/cuda:12.9.1-runtime-ubuntu24.04

# Avoid interactive prompts during apt-get
ENV DEBIAN_FRONTEND=noninteractive

# Python 3.12 + native libs for opencv, librosa, etc.
#
# Ubuntu 24.04 marks its system Python externally managed (PEP 668), so pip
# refuses to install into it; everything goes into a venv on PATH instead. The
# base also ships an `ubuntu` user holding UID 1000, which the non-root user
# created below needs.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 \
        python3-venv \
        libsndfile1 \
        ffmpeg \
        libgl1 \
        libglib2.0-0 && \
    rm -rf /var/lib/apt/lists/* && \
    python3 -m venv /opt/venv && \
    userdel --remove ubuntu
ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH

WORKDIR /app

# ---------- dependency layer ----------
# requirements/gpu.txt forwards to pyproject.toml via `-e .[dev,agpl]`, so the
# package source needs to be present when this layer builds. That means
# any Python source change busts this layer; full source copy happens here.
COPY requirements/ requirements/
COPY pyproject.toml ./
COPY vtsearch/ vtsearch/

# The image includes the two AGPL-3.0 dependencies (ultralytics, PyMuPDF) by
# default, so the YOLO and PDF/document features work out of the box in a
# turnkey deployment. To build an image without them -- forgoing those
# features -- point this at the opt-out mirror:
#
#   docker build --build-arg REQUIREMENTS=gpu-no-agpl.txt ...
#
# See NOTICE and docs/DEPLOYMENT.md.
ARG REQUIREMENTS=gpu.txt

# Pre-install numpy/scipy as binary-only wheels so the PyTorch extra-index
# cannot pull in source tarballs that require g++. Then pin torch from the CUDA
# index with --index-url (NOT --extra-index-url): otherwise PyPI stays a
# candidate and a newer PyPI torch overrides the cu129 build with a wrong-arch
# wheel (cudaErrorNoKernelImageForDevice at runtime on unsupported GPUs).
# cu129 is the tag whose torch pins the CUDA 12.9 libraries the cuML layer
# below is built on (scripts/install.sh picks the same tag on Turing..Blackwell
# hosts); it ships no Volta (sm_70) kernels, so a V100 host needs install.sh
# with cu124 rather than this image.
RUN pip install --no-cache-dir --upgrade pip setuptools && \
    pip install --no-cache-dir --only-binary :all: numpy scipy && \
    pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cu129 \
        --prefer-binary \
        torch torchvision torchaudio && \
    pip install --no-cache-dir \
        --extra-index-url https://download.pytorch.org/whl/cu129 \
        --prefer-binary \
        -r "requirements/$REQUIREMENTS"

# ---------- VTSBrowse signpost naming (toponymy) ----------
# Docker builds never run scripts/install.sh, so this step mirrors its
# `vts_install_toponymy` by hand. Without it the image ships without
# `toponymy` and every Browse map renders unlettered, behind a one-time
# "VTSBrowse signposts are disabled" error in the log (issue #3852).
#
# `--no-deps` is the whole reason this cannot live in requirements/ (pip
# rejects the flag inside a requirements file): toponymy 0.5.2 pins
# `transformers<5.0.0`, which a plain install would honour by downgrading the
# image's transformers stack. That pin is empirically unnecessary for our
# usage -- see docs/plans/vtsbrowse-toponymy.md -- so the package goes in bare
# and its real dependencies (fast_hdbscan, vectorizers, apricot-select,
# tenacity, jinja2) come from `requirements/$REQUIREMENTS`, which declares
# them on toponymy's behalf through pyproject.toml.
RUN pip install --no-cache-dir --no-deps "toponymy==0.5.2"

# ---------- cuML / RAPIDS layer (GPU UMAP + k-means) ----------
# cuML accelerates the VTSBrowse UMAP projection and the diversity-tree k-means
# (~20-100x on large sets); without it the app falls back to CPU umap-learn /
# scikit-learn (see vtscore/gpu_backends.py). The base image is CUDA 12, so we
# install the cuml-cu12 wheel from the NVIDIA index. This is its own RUN layer
# so it stays cache-friendly and doesn't disturb the pinned torch install above.
#
# Unlike scripts/install.sh (best-effort on heterogeneous hosts), this is
# fail-loud on purpose: a build-once-ship image should break here if cuML can't
# resolve against the pinned torch build, rather than silently shipping a 12 GB
# GPU image that still runs UMAP on the CPU. Adds ~3-4 GB to the image.
#
# Floored at RAPIDS 26.8 to match scripts/install.sh: it is the first RAPIDS
# whose cudf takes the pandas 3 that pyproject.toml pins (an older one would
# downgrade pandas here, #4390), and it requires nvidia-nvjitlink-cu12>=12.9,
# which the cu129 torch pinned above satisfies with the same 12.9.x libraries
# RAPIDS is built on. `pandas>=3` is repeated so a RAPIDS that could not take it
# fails this layer instead of quietly moving pandas. See docs/DEPLOYMENT.md
# "cuML crashes compiling a kernel".
RUN pip install --no-cache-dir \
        --extra-index-url https://pypi.nvidia.com \
        --prefer-binary \
        "cuml-cu12>=26.8" "pandas>=3"

# ---------- application layer ----------
COPY . .

# Overlay the freshly-built Angular bundle from the frontend stage so
# the image is never served with a stale checked-in static/ snapshot.
RUN rm -rf /app/static
COPY --from=frontend /static/ /app/static/

# Bake the version into the image. See Dockerfile for the pattern.
ARG VTSEARCH_VERSION=
RUN if [ -n "$VTSEARCH_VERSION" ]; then echo "$VTSEARCH_VERSION" > vtsearch/_version.txt; fi

RUN mkdir -p /app/data
VOLUME /app/data

# Run as a non-root user. See the CPU Dockerfile for the rationale and
# the GID-0 / g=u perm pattern that lets arbitrary OpenShift UIDs write.
RUN useradd --uid 1000 --gid 0 --create-home --home-dir /home/vtsearch vtsearch && \
    chgrp -R 0 /app /home/vtsearch && \
    chmod -R g=u /app /home/vtsearch

ENV HOME=/home/vtsearch
USER 1000

EXPOSE 5000

ENV OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    PYTHONUNBUFFERED=1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    VTSEARCH_SERVER_INIT=1

CMD ["gunicorn", "-c", "gunicorn.conf.py", "app:app"]
