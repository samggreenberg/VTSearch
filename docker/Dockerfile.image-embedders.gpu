# -----------------------------------------------------------------
# VTSearch: All-image-embedders GPU (CUDA) image
#
# GPU twin of Dockerfile.image-embedders. Same six embedders, same
# baked-in weights, but on the CUDA 12.1 runtime base with PyTorch
# pulled from the cu121 wheel index so the embedders actually use the
# GPU at inference time.
#
# Embedders bundled (identical to the CPU image):
#
#   * SigLIP   (google/siglip-base-patch16-224)         - default, text-capable
#   * SigLIP 2 (google/siglip2-base-patch16-224)        - text-capable
#   * CLIP     (openai/clip-vit-base-patch32)           - text-capable
#   * DINOv2   (facebook/dinov2-base)                     - image-only, ungated
#   * DINOv3   (facebook/dinov3-vitb16-pretrain-lvd1689m) - image-only, gated
#   * EUPE     (facebookresearch/EUPE, ViT-B/16)          - image-only, ungated
#                                                          (FAIR Noncommercial
#                                                          Research Licence on
#                                                          *outputs*, not on
#                                                          download access)
#
# Gated weights (DINOv3, optionally EUPE's GitHub clone) are sourced
# from the host's ./model_cache/; populate it with
# scripts/cache_gated_models.sh BEFORE building. See the comments in
# Dockerfile.image-embedders for the full rationale.
#
# Build:
#   # 1. ONE-TIME setup to bake DINOv3 + EUPE into the image (skip if you
#   #    only want SigLIP / SigLIP 2 / CLIP / DINOv2). HF_TOKEN is needed
#   #    only for DINOv3; pass SKIP_DINOV3=1 to cache only EUPE:
#   HF_TOKEN=hf_xxx ./scripts/cache_gated_models.sh
#   #   …or, EUPE only (no token needed):
#   SKIP_DINOV3=1 ./scripts/cache_gated_models.sh
#
#   # 2. Build the image (from repo root); no token, no secrets:
#   docker build -f docker/Dockerfile.image-embedders.gpu \
#                -t vtsearch:image-embedders-gpu .
#
# Run:
#   docker run --gpus all -p 5000:5000 \
#              -v vtsearch-data:/app/data \
#              vtsearch:image-embedders-gpu
#
# Requires the NVIDIA Container Toolkit on the host:
#   https://docs.nvidia.com/datacenter/cloud-native/container-toolkit/
#
# Build args:
#   * VTSEARCH_VERSION: bake a version string into the image
# -----------------------------------------------------------------

# ---------- frontend build stage ----------
# Builds the Angular SPA inside the image so callers never have to run
# `npm run build:prod` on the host. Output lands at /static because
# frontend/angular.json sets outputPath to "../static" relative to the
# frontend/ workdir. The final stage COPYs /static into /app/static.
FROM node:20-slim AS frontend
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build:prod

FROM nvidia/cuda:12.1.1-runtime-ubuntu22.04

# Avoid interactive prompts during apt-get
ENV DEBIAN_FRONTEND=noninteractive

# Python 3.10 + the handful of native libs Pillow / transformers pull in.
# (No ffmpeg / libsndfile here; this image is image-only.)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3.10 \
        python3.10-venv \
        python3-pip \
        libgl1 \
        libglib2.0-0 && \
    rm -rf /var/lib/apt/lists/* && \
    ln -sf /usr/bin/python3.10 /usr/bin/python

WORKDIR /app

# ---------- dependency layer (cached unless requirements/*.txt change) ----
COPY requirements/image-embedders-gpu.txt requirements/
COPY pyproject.toml ./
COPY vtsearch/__init__.py vtsearch/__init__.py

# Copy package source so `pip install -e .` finds it.
COPY vtsearch/ vtsearch/

# Pre-install numpy/scipy as binary-only wheels so the PyTorch extra-index
# cannot pull in source tarballs that require g++.
RUN pip install --no-cache-dir --upgrade pip setuptools && \
    pip install --no-cache-dir --only-binary :all: numpy scipy && \
    pip install --no-cache-dir \
        --extra-index-url https://download.pytorch.org/whl/cu121 \
        --prefer-binary \
        -r requirements/image-embedders-gpu.txt && \
    pip install --no-cache-dir --no-deps -e .

# ---------- pre-download every image embedder's weights ------------------
# Bake weights into a non-volume path so they survive volume mounts on
# /app/data. The app reads MODELS_CACHE_DIR from VTSEARCH_MODELS_DIR.
#
# Each block is a separate RUN so a transient HF outage on one model
# doesn't invalidate the layers above it. PYTHONUNBUFFERED + python -u +
# flushed prints surface progress in BuildKit's UI.
# HF_HUB_DOWNLOAD_TIMEOUT makes a stalled connection error out (and
# huggingface_hub auto-retry) instead of blocking the build forever.
ENV VTSEARCH_MODELS_DIR=/opt/vtsearch/models \
    HF_HUB_DOWNLOAD_TIMEOUT=120 \
    PYTHONUNBUFFERED=1
RUN mkdir -p "$VTSEARCH_MODELS_DIR"

# Copy any host-side cached gated weights into the image cache, if the
# user ran scripts/cache_gated_models.sh. We seed an empty
# model_cache/.gitkeep in the repo so this COPY succeeds even when the
# cache is empty (docker COPY needs at least one matching source).
COPY model_cache/ "$VTSEARCH_MODELS_DIR/"

# SigLIP (default, ungated).
RUN python -u -c "import os; \
from vtsearch.config import SIGLIP_MODEL_ID; \
cache=os.environ['VTSEARCH_MODELS_DIR']; \
print(f'Pre-downloading {SIGLIP_MODEL_ID} to {cache}', flush=True); \
from transformers import SiglipModel, SiglipImageProcessor, SiglipTokenizer; \
SiglipModel.from_pretrained(SIGLIP_MODEL_ID, cache_dir=cache); \
SiglipImageProcessor.from_pretrained(SIGLIP_MODEL_ID, cache_dir=cache); \
SiglipTokenizer.from_pretrained(SIGLIP_MODEL_ID, cache_dir=cache); \
print('SigLIP weights cached.', flush=True)"

# SigLIP 2 (ungated).
RUN python -u -c "import os; \
from vtsearch.config import SIGLIP2_MODEL_ID; \
cache=os.environ['VTSEARCH_MODELS_DIR']; \
print(f'Pre-downloading {SIGLIP2_MODEL_ID} to {cache}', flush=True); \
from transformers import AutoModel, AutoProcessor; \
AutoModel.from_pretrained(SIGLIP2_MODEL_ID, cache_dir=cache); \
AutoProcessor.from_pretrained(SIGLIP2_MODEL_ID, cache_dir=cache); \
print('SigLIP 2 weights cached.', flush=True)"

# OpenAI CLIP (ungated).
RUN python -u -c "import os; \
from vtsearch.config import CLIP_MODEL_ID; \
cache=os.environ['VTSEARCH_MODELS_DIR']; \
print(f'Pre-downloading {CLIP_MODEL_ID} to {cache}', flush=True); \
from transformers import CLIPModel, CLIPProcessor; \
CLIPModel.from_pretrained(CLIP_MODEL_ID, cache_dir=cache); \
CLIPProcessor.from_pretrained(CLIP_MODEL_ID, cache_dir=cache); \
print('CLIP weights cached.', flush=True)"

# DINOv2 (ungated; anyone can download these).
RUN python -u -c "import os; \
from vtsearch.config import DINOV2_MODEL_ID; \
cache=os.environ['VTSEARCH_MODELS_DIR']; \
print(f'Pre-downloading {DINOV2_MODEL_ID} to {cache}', flush=True); \
from transformers import AutoModel, AutoImageProcessor; \
AutoModel.from_pretrained(DINOV2_MODEL_ID, cache_dir=cache); \
AutoImageProcessor.from_pretrained(DINOV2_MODEL_ID, cache_dir=cache); \
print('DINOv2 weights cached.', flush=True)"

# DINOv3 (gated). The COPY above seeded $VTSEARCH_MODELS_DIR from the
# host's ./model_cache/. ``local_files_only=True`` makes this RUN succeed
# whenever the cache script populated the weights, and fail loudly only
# when the user did neither ran the cache script nor accepted that
# DINOv3 will be unavailable. We swallow the failure so the build still
# produces a usable image with the other five embedders.
RUN python -u -c "import os; \
from vtsearch.config import DINOV3_MODEL_ID; \
from transformers import AutoModel, AutoImageProcessor; \
cache=os.environ['VTSEARCH_MODELS_DIR']; \
AutoModel.from_pretrained(DINOV3_MODEL_ID, cache_dir=cache, local_files_only=True); \
AutoImageProcessor.from_pretrained(DINOV3_MODEL_ID, cache_dir=cache, local_files_only=True); \
print('DINOv3 weights loaded from local cache.', flush=True)" \
    || echo "DINOv3 not in local cache; skipping. Run scripts/cache_gated_models.sh on the host to enable DINOv3."

# EUPE (facebookresearch/EUPE, ViT-B/16). Loads via torch.hub: a cloned
# GitHub repo plus a downloaded .pt weights file, both under
# $TORCH_HOME/hub/. We point TORCH_HOME at the same dir the COPY above
# seeded from ./model_cache/ so a host-cache run skips both the clone
# and the weights download. If neither is present we still attempt the
# fetch (EUPE's HF mirror is ungated; no token required) and fall back
# to skipping EUPE if the build host has no network access.
ENV TORCH_HOME=${VTSEARCH_MODELS_DIR}
RUN python -u -c "import os; \
from vtsearch.config import EUPE_MODEL_ID; \
import torch; \
torch.hub.load('facebookresearch/EUPE', 'eupe_vitb16', source='github', \
               pretrained=True, weights=EUPE_MODEL_ID, trust_repo=True); \
print('EUPE weights cached via torch.hub.', flush=True)" \
    || echo "EUPE not cached; skipping. Run scripts/cache_gated_models.sh on the host to enable EUPE in offline builds."

# ---------- application layer ----------
COPY . .

# Overlay the freshly-built Angular bundle from the frontend stage so
# the image is never served with a stale checked-in static/ snapshot.
RUN rm -rf /app/static
COPY --from=frontend /static/ /app/static/

# Bake the version into the image. See Dockerfile for the pattern.
ARG VTSEARCH_VERSION=
RUN if [ -n "$VTSEARCH_VERSION" ]; then echo "$VTSEARCH_VERSION" > vtsearch/_version.txt; fi

# Seed default settings so SigLIP is preloaded at startup (the other
# embedders stay cold until explicitly selected; they all live on
# disk thanks to the RUNs above, so first selection is a from-cache
# load rather than a HF download).
RUN mkdir -p /app/data && \
    printf '{\n  "autoload_media_embedders": ["siglip"]\n}\n' > /app/data/settings.json

# Runtime data directory (settings, embeddings, datasets, media files).
# Mount a volume here to persist user data across container restarts.
# Note: model weights live under /opt/vtsearch/models, NOT this volume.
VOLUME /app/data

# Run as a non-root user. See the CPU Dockerfile for the rationale and
# the GID-0 / g=u perm pattern that lets arbitrary OpenShift UIDs write.
# /opt/vtsearch/models is also opened up so the baked-in HuggingFace
# snapshots stay readable when the runtime UID is unknown at build time.
RUN useradd --uid 1000 --gid 0 --create-home --home-dir /home/vtsearch vtsearch && \
    chgrp -R 0 /app /home/vtsearch /opt/vtsearch && \
    chmod -R g=u /app /home/vtsearch /opt/vtsearch

ENV HOME=/home/vtsearch
USER 1000

EXPOSE 5000

ENV OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    VTSEARCH_SERVER_INIT=1

CMD ["gunicorn", "-c", "gunicorn.conf.py", "app:app"]
